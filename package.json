{
  "name": "evaluator-system",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node scripts/test-scoring-logic.mjs && node scripts/test-rubric-fallback.mjs && node scripts/test-url-guard.mjs && node scripts/test-code-and-temporal-checks.mjs",
    "test:excel": "node scripts/run-excel-golden-suite.mjs",
    "benchmark:excel": "node scripts/benchmark-excel-queue.mjs",
    "start": "node --watch server.js",
    "dev": "node --watch server.js",
    "postinstall": "playwright install chromium"
  },
  "keywords": [
    "evaluator",
    "queue",
    "redis",
    "bullmq",
    "automation",
    "code-evaluation"
  ],
  "author": "Barabari collective dev team",
  "license": "ISC",
  "description": "Distributed automated evaluation platform for assessing student submissions",
  "dependencies": {
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "bullmq": "^5.76.8",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "fs-extra": "^11.2.0",
    "globby": "^16.2.0",
    "groq-sdk": "^1.2.1",
    "ioredis": "^5.10.1",
    "jest": "^30.4.2",
    "openai": "^4.52.0",
    "playwright": "^1.45.0",
    "serve-handler": "^6.1.7",
    "simple-git": "^3.36.0",
    "supertest": "^7.2.2",
    "vm2": "^3.9.19",
    "winston": "^3.19.0"
  }
}
